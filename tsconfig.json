{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "types": ["bun", "$app/types"],
    "sourceMap": true,
    "strict": true,
    // `#lib` は package.json の `imports` で解決されるが、`svelte-check --tsgo` はそれ経由の
    // `.svelte` の型を拾えず、コンポーネントの props が検査されなくなる。ここでも同じ道を示す
    "paths": { "#lib/*": ["./src/lib/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
