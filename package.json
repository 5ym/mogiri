    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@typescript/native": "npm:typescript@7",
    "html5-qrcode": "^2.3.8",
    "oxlint": "^1.91.0",
    "qrcode": "^1.5.4",
    "stripe": "^23.1.0",
    "svelte": "^5.57.3",
