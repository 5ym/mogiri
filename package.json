{
	"name": "mogiri",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test src",
		"db:seed": "bun run src/lib/server/db/seed.ts"
	},
	"devDependencies": {
		"@anyblades/blades": "^3.0.0",
		"@biomejs/biome": "^2.5.15",
		"@stripe/stripe-js": "^10.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.2",
		"@types/qrcode": "^1.5.6",
		"@typescript/native": "npm:typescript@7",
		"html5-qrcode": "^2.3.8",
		"qrcode": "^1.5.4",
		"stripe": "^23.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"vite": "^8.3.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
